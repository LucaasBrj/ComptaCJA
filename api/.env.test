# Symfony ignore volontairement .env.local en environnement de test, pour que la
# suite soit reproductible. La configuration de test doit donc etre declaree ici.
# Doctrine ajoute automatiquement le suffixe "_test" au nom de la base (voir doctrine.yaml).
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="postgresql://cja:cja@127.0.0.1:5432/cja?serverVersion=17&charset=utf8"
KERNEL_CLASS='App\Kernel'
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR='./var/error-screenshots'
