# Modele de configuration de production. Copier vers .env.prod SUR LE VPS, puis :
#   chmod 600 .env.prod
# Ne jamais commiter .env.prod.
#
# Generer un secret : openssl rand -hex 32
# Utiliser uniquement des caracteres hexadecimaux ou alphanumeriques pour les mots de passe
# (POSTGRES_PASSWORD entre dans une URL). Eviter le caractere $ dans toutes les valeurs.

# --- Acces public ---------------------------------------------------------------------------
# IP ou nom de domaine du VPS, sans http(s)://
SITE_ADDRESS=203.0.113.10
# Sans domaine (IP) : certificat auto-signe, le navigateur affichera un avertissement.
CADDY_TLS=tls internal
# Avec un vrai domaine : Let's Encrypt, certificat reconnu. Remplacer les deux lignes par :
#   SITE_ADDRESS=cja.exemple.fr
#   CADDY_TLS=tls vous@exemple.fr

# --- Application ----------------------------------------------------------------------------
APP_SECRET=remplacer-par-openssl-rand-hex-32
JWT_PASSPHRASE=remplacer-par-openssl-rand-hex-32

# --- Base de donnees ------------------------------------------------------------------------
POSTGRES_DB=cja
POSTGRES_USER=cja
POSTGRES_PASSWORD=remplacer-par-openssl-rand-hex-32

# --- E-mails --------------------------------------------------------------------------------
# null://null desactive l'envoi. Pour un envoi reel, un DSN SMTP, par exemple :
#   smtp://utilisateur:motdepasse@smtp.exemple.fr:587
# (caracteres speciaux du mot de passe a encoder en URL)
MAILER_DSN=null://null
